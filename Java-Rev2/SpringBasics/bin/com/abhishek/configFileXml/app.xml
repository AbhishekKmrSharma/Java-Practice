<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans
http://www.springframework.org/schema/beans/spring-beans-3.0.xsd">

	<bean id="stdId" class="com.abhishek.Student">

		<property name="name" value="Abhishek"></property>
		<property name="age" value="28"></property>
		<property name="gender" value='M'></property>
		<property name="add" ref ="addr"></property>

	</bean>

	<bean id="addr" class="com.abhishek.Address">
	
		<property name="city" value="PTK"></property>
		<property name="pincode" value = "145001"></property>

	</bean>








</beans>